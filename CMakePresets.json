{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug", "displayName": "Linux GCC Debug", "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "UMBRA_DEPS_PREFIX": "${sourceDir}/third_party/local"
      }
    },
    {
      "name": "release", "displayName": "Linux GCC Release", "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "UMBRA_DEPS_PREFIX": "${sourceDir}/third_party/local"
      }
    },
    {
      "name": "windows-mingw-debug", "displayName": "Windows MinGW Debug", "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "environment": {
        "PATH": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "UMBRA_DEPS_PREFIX": "${sourceDir}/third_party/local-msys2"
      }
    },
    {
      "name": "windows-mingw-release", "displayName": "Windows MinGW Release", "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/install/${presetName}",
      "environment": {
        "PATH": "C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "UMBRA_DEPS_PREFIX": "${sourceDir}/third_party/local-msys2"
      }
    }
  ],
  "buildPresets": [
    {"name":"debug", "configurePreset":"debug"},
    {"name":"release", "configurePreset":"release"},
    {"name":"windows-mingw-debug", "configurePreset":"windows-mingw-debug"},
    {"name":"windows-mingw-release", "configurePreset":"windows-mingw-release"}
  ],
  "testPresets": [
    {"name":"debug", "configurePreset":"debug", "output":{"outputOnFailure":true}},
    {"name":"release", "configurePreset":"release", "output":{"outputOnFailure":true}},
    {"name":"windows-mingw-debug", "configurePreset":"windows-mingw-debug", "output":{"outputOnFailure":true}},
    {"name":"windows-mingw-release", "configurePreset":"windows-mingw-release", "output":{"outputOnFailure":true}}
  ]
}
